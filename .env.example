# Copy to .env and fill in real values. .env is git-ignored.
JWT_SECRET=change-me-to-a-long-random-string
SAFEPAY_API_KEY=sec_your_merchant_api_key
SAFEPAY_MERCHANT_SECRET=your_merchant_secret_for_x_sfpy_merchant_secret_header
SAFEPAY_WEBHOOK_SECRET=your_webhook_hmac_signing_secret
# Email via Resend. EMAIL_MOCK=true keeps it log-only (CI + safe default).
# Without a verified domain, RESEND_FROM must stay onboarding@resend.dev and
# Resend only delivers to the address that owns the account.
RESEND_API_KEY=re_placeholder
RESEND_FROM=onboarding@resend.dev
EMAIL_MOCK=true
# Set SAFEPAY_MOCK=true to mint local trackers (no Safepay network calls) --
# used by CI and for a hermetic local e2e run.
SAFEPAY_MOCK=false
# Optional:
# PUBLIC_BASE_URL=http://localhost:80   (redirect target after hosted checkout)
# ORDER_TIMEOUT_MINUTES=15              (pending-order grace period)